# Node
# No trailing slash: a trailing slash matches directories only, so a
# node_modules symlink (one worktree borrowing another's install) slipped
# past this and was committed once.
node_modules
dist/
coverage/
test-results/
playwright-report/

# Build-time Ajv output (web/scripts/gen-validators.mjs regenerates it)
/web/src/protocol/validators.generated.js
/web/src/protocol/validators.generated.d.ts

