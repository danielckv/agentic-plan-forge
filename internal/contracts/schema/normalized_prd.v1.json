{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "normalized_prd.v1.json",
  "title": "Normalized PRD produced by the ingestion stage",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "product", "ambiguities"],
  "properties": {
    "schema_version": { "const": 1 },
    "product": {
      "type": "object",
      "additionalProperties": false,
      "required": ["goals", "actors", "flows", "requirements", "acceptance_criteria", "constraints", "open_questions"],
      "properties": {
        "title": { "type": "string", "maxLength": 300 },
        "problem": { "type": "string", "maxLength": 20000 },
        "goals": { "type": "array", "items": { "type": "string", "maxLength": 2000 }, "maxItems": 200 },
        "actors": { "type": "array", "items": { "type": "string", "maxLength": 2000 }, "maxItems": 200 },
        "flows": { "type": "array", "items": { "type": "string", "maxLength": 4000 }, "maxItems": 200 },
        "requirements": { "type": "array", "items": { "type": "string", "maxLength": 4000 }, "maxItems": 500 },
        "acceptance_criteria": { "type": "array", "items": { "type": "string", "maxLength": 4000 }, "maxItems": 500 },
        "constraints": { "type": "array", "items": { "type": "string", "maxLength": 4000 }, "maxItems": 200 },
        "open_questions": { "type": "array", "items": { "type": "string", "maxLength": 2000 }, "maxItems": 200 }
      }
    },
    "technical_appendix": { "type": "string", "maxLength": 200000 },
    "ambiguities": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "text", "question"],
        "properties": {
          "id": { "type": "string", "minLength": 1, "maxLength": 64 },
          "text": { "type": "string", "maxLength": 2000 },
          "question": { "type": "string", "maxLength": 1000 },
          "guess": { "type": "string", "enum": ["product", "technical"] }
        }
      }
    },
    "warnings": { "type": "array", "items": { "type": "string", "maxLength": 2000 }, "maxItems": 200 }
  }
}
