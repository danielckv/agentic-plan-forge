{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "envelope.v1.json",
  "title": "Plan Forge wire envelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "session_id",
    "sender_id",
    "event_id",
    "event_type",
    "seq",
    "revision",
    "epoch",
    "timestamp",
    "payload"
  ],
  "properties": {
    "version": { "const": 1 },
    "session_id": { "type": "string", "minLength": 1, "maxLength": 64 },
    "sender_id": { "type": "string", "minLength": 1, "maxLength": 64 },
    "event_id": { "type": "string", "minLength": 1, "maxLength": 64 },
    "event_type": { "type": "string", "enum": [
      "TEXT_DELTA",
      "PAGE_TRANSITION",
      "CYCLE_START",
      "AVATAR_THOUGHT",
      "AVATAR_DRAFT",
      "AVATAR_CRITIQUE",
      "DECISION_PROMPT",
      "DECISION_RESOLVE",
      "PLAN_APPROVED",
      "HELLO",
      "STATE_SNAPSHOT",
      "REPLAY_REQUEST",
      "PRESENCE",
      "FREEZE_REQUEST",
      "LEASE_CLAIM",
      "LEASE_GRANTED",
      "LEASE_RENEW",
      "LEASE_RELEASE",
      "LEASE_LOST",
      "FENCED",
      "CANCEL",
      "ERROR",
      "APPROVE",
      "APPROVAL_PREPARED",
      "ARTIFACT_SAVED",
      "ARTIFACT_SYNCED",
      "SYNTHESIZE_REQUEST",
      "RETRY_STAGE",
      "EDIT_BASELINE",
      "INGEST_APPEND",
      "RUN_ASSIGNED",
      "AMBIGUITY_RESOLVE",
      "INVITE_REVOKE",
      "MEMBER_REMOVE",
      "EXECUTOR_LEFT",
      "EXECUTOR_LOST",
      "RUN_SUPERSEDED",
      "ALREADY_RESOLVED",
      "TEXT_ACK",
      "TEXT_REJECT",
      "TEXT_UPDATES",
      "TEXT_SNAPSHOT",
      "TEXT_CHECK"
    ] },
    "seq": { "type": "string", "pattern": "^[0-9]{1,20}$" },
    "revision": { "type": "string", "pattern": "^[0-9]{1,20}$" },
    "epoch": { "type": "string", "pattern": "^[0-9]{1,20}$" },
    "timestamp": { "type": "string", "format": "date-time" },
    "payload": {}
  }
}
