# Plan-Forge relay image. Multi-stage: build with CGO disabled (the relay
# depends on no tree-sitter/host code), then ship the static binary on a
# distroless non-root base. The build stage always runs on the builder's
# native platform and cross-compiles, so multi-architecture images need no
# emulation.
FROM --platform=$BUILDPLATFORM golang:1.27.2 AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
ARG VERSION=dev
ARG TARGETOS
ARG TARGETARCH
RUN CGO_ENABLED=0 GOOS=${TARGETOS} GOARCH=${TARGETARCH} go build -tags server -trimpath \
    -ldflags "-s -w -X main.version=${VERSION}" \
    -o /out/plan-forge-relay ./cmd/relay

FROM gcr.io/distroless/static-debian12
COPY --from=build /out/plan-forge-relay /plan-forge-relay
USER nonroot:nonroot
ENTRYPOINT ["/plan-forge-relay"]
